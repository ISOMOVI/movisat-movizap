# ---- segredos (NUNCA versionar) ----
.env
.env.*
!.env.example
alembic.ini
*.pem
*.key

# ---- ambiente ----
venv/
__pycache__/
*.pyc
*.pyo
node_modules/
.vite/

# ---- gerado pelo build do frontend ----
# `dist` e reconstruivel com `npm ci && npm run build`. Versionar bundle
# minificado suja todo diff e mente sobre o que mudou de verdade.
frontend/dist/
.pytest_cache/

# ---- dados e runtime ----
data/
logs/
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
# ...MENOS as migracoes. A regra "*.sql" acima existe para dump de dados, e
# em 05/08 ela engoliu o 001_inicial.sql -- justamente o arquivo que DEFINE
# o banco, e que quase foi commitado sem ninguem notar.
# Dump e dado descartavel; migracao e codigo e tem que estar no historico.
!migracoes/
!migracoes/*.sql

# ---- lixo de edicao ----
backups/
*.bak
*.bak_*
*.bak2_*
*.bak3_*
.DS_Store

# ---- satelites do SQLite em modo WAL ----
# `*.db` NAO casa com estes. Sao estado de runtime e, no caso do contador de
# tentativas de login, carregam IP e nome de conta.
*.db-wal
*.db-shm
*.db-journal

# ---- chave da conta de servico (delegacao em todo o dominio) ----
# 🚨 Le e envia e-mail de QUALQUER pessoa do dominio. Nunca versionar.
.google_sa.json
*-sa.json
